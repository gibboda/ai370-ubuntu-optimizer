{
  "schema_version": 1,
  "mutations": [
    {
      "id": "authority-replaced",
      "target": "roles",
      "path": "authority",
      "value": "TOOL.md",
      "expected_rule": "canonical_authority"
    },
    {
      "id": "primary-provider-replaced",
      "target": "roles",
      "path": "roles.primary_orchestrator.provider",
      "value": "github_copilot",
      "expected_rule": "primary_orchestrator"
    },
    {
      "id": "deterministic-validation-disabled",
      "target": "roles",
      "path": "roles.deterministic_validation.before_ai_escalation",
      "value": false,
      "expected_rule": "deterministic_before_escalation"
    },
    {
      "id": "reviewer-made-merge-gate",
      "target": "roles",
      "path": "roles.independent_reviewer.merge_gate",
      "value": true,
      "expected_rule": "advisory_review"
    },
    {
      "id": "ai-merge-authority-enabled",
      "target": "roles",
      "path": "roles.merge_authority.ai_allowed",
      "value": true,
      "expected_rule": "human_merge_authority"
    },
    {
      "id": "vendor-chaining-enabled",
      "target": "roles",
      "path": "invariants.no_automatic_vendor_chaining",
      "value": false,
      "expected_rule": "no_vendor_chaining"
    },
    {
      "id": "overlay-removed",
      "target": "roles",
      "operation": "remove_overlay",
      "value": ".cursor/rules/cursor.mdc",
      "expected_rule": "overlay_completeness"
    },
    {
      "id": "compatibility-authority-replaced",
      "target": "compatibility",
      "path": "authority",
      "value": "config/agent-roles.json",
      "expected_rule": "canonical_authority"
    },
    {
      "id": "compatibility-contract-removed",
      "target": "compatibility",
      "operation": "remove_contract",
      "value": "mcp",
      "expected_rule": "contract_coverage"
    },
    {
      "id": "compatibility-version-mismatch",
      "target": "compatibility",
      "path": "contracts.roles.schema_version",
      "value": 999,
      "expected_rule": "schema_version_match"
    }
  ]
}
