# Strix Halo shared-memory optimization profile.
# Officially documented plan data for AMD Ryzen AI MAX / MAX+ (codename Strix Halo).
# Source: ROCm "AMD Strix Halo system optimization".
# S2-M5 records this file. It does not change TTM, GTT, BIOS, or kernel settings.

OPTIMIZATION_PROFILE_ID="strix-halo-shared-memory"
PLATFORM_ARCHITECTURE="ryzen-ai-linux"
HARDWARE_PROFILE="strix-halo-ryzen-ai"
GPU_ARCH="gfx1151"
MEMORY_MODEL="unified-lpddr5x"
GTT_GUIDANCE="default GTT is about half of system RAM; AI frameworks prefer GTT-backed allocations"
VRAM_GUIDANCE="keep the dedicated VRAM reservation small and raise the shared TTM limit instead of carving out RAM"
KERNEL_GUIDANCE="ROCm documents Strix Halo KFD fixes in Linux 6.18.4 and newer. This is not a generic kernel gate."
APPLY="false"
