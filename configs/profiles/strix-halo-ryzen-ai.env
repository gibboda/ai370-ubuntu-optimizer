# Ryzen AI Halo / Strix Halo hardware profile.
# Same platform architecture as ai370. Not a second platform.
# AMD product family: Ryzen AI MAX / MAX+ (codename Strix Halo).
# GPU target gfx1151 is from ROCm Strix Halo documentation.
# Do not copy AI370 BIOS 2.01 or gfx1150 onto this profile.

PROFILE_ID="strix-halo-ryzen-ai"
PROFILE_NAME="AMD Ryzen AI MAX / Strix Halo"
PLATFORM_ARCHITECTURE="ryzen-ai-linux"
HARDWARE_FAMILY="strix-halo"
PROFILE_VALIDATION="family"
PROFILE_STRICT_DEFAULT="false"
EXPECTED_VENDOR="AMD"
EXPECTED_CPU_FAMILY="Ryzen AI MAX"
EXPECTED_GPU_ARCH="gfx1151"
EXPECTED_NPU_FAMILY="xdna2"
ALLOW_NON_AI370="true"
