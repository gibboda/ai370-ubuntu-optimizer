# Minisforum AI Series (Ryzen AI 9 HX 470) hardware profile.
# Stage 1 probe verified on reference hardware (2026-11-03); Stage 2+ integration is pending.
# Do not inherit EliteMini AI370 BIOS 2.01 or strict default profile behavior.
# Observed firmware on the reference probe: BIOS 1.00 (release date 2026-01-15) in fixture
# firmware.bios_* fields only — not an EXPECTED_BIOS_VERSION enforcement target.

PROFILE_ID="ai470"
PROFILE_NAME="Minisforum AI Series (Ryzen AI 9 HX 470)"
PLATFORM_ARCHITECTURE="ryzen-ai-linux"
HARDWARE_FAMILY="strix-point"
PROFILE_VALIDATION="stage1-probe"
PROFILE_STRICT_DEFAULT="false"

EXPECTED_CPU="Ryzen AI 9 HX 470"
EXPECTED_GPU_ARCH="gfx1150"
EXPECTED_NPU_FAMILY="xdna2"
EXPECTED_VENDOR="AMD"

ALLOW_NON_AI370="true"
