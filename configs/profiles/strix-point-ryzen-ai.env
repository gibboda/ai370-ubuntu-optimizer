# Strix Point family hardware profile.
# Exact EliteMini AI370 identity stays in ai370.env, including BIOS 2.01.
# This family profile does not inherit that BIOS target.

PROFILE_ID="strix-point-ryzen-ai"
PROFILE_NAME="AMD Ryzen AI 300 / Strix Point"
PLATFORM_ARCHITECTURE="ryzen-ai-linux"
HARDWARE_FAMILY="strix-point"
PROFILE_VALIDATION="family"
PROFILE_STRICT_DEFAULT="false"
EXPECTED_VENDOR="AMD"
EXPECTED_CPU_FAMILY="ryzen-ai-300"
EXPECTED_GPU_ARCH="gfx1150"
EXPECTED_NPU_FAMILY="xdna2"
ALLOW_NON_AI370="true"
