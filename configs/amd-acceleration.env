# SPDX-License-Identifier: GPL-3.0-only
# Opt-in AMD acceleration installation settings.
# Defaults target Ubuntu 26.04 LTS (Resolute Raccoon) AMD ROCm package-manager layout;
# override these values locally if AMD publishes different package naming or
# repository support guidance for a newer ROCm release.

ROCM_VERSION="7.2.4"
ROCM_REPO_CODENAME="resolute"
ROCM_PACKAGES="rocm rocm-hip-runtime rocm-hip-sdk rocm-ml-sdk rocm-opencl-sdk amdgpu-lib"
ROCM_INSTALL_MODE="online"

# Ryzen AI Linux packages must be downloaded from AMD account/download pages and
# staged locally before this toolkit can install them. Paths are relative to the
# repository root unless absolute.
AMD_ARTIFACT_ROOT=".ai370-ai/amd-artifacts"
RYZEN_AI_ARTIFACT_GLOB="ryzen_ai-*.tgz"
# Optional Ubuntu version preference for XRT/NPU .deb filenames (e.g. "26.04 24.04").
# Leave empty (recommended): auto-detect from the host VERSION_ID, the previous
# Ubuntu LTS, and version tags discovered in staged deb names under
# AMD_ARTIFACT_ROOT (host match first, then newest discovered tags).
XRT_UBUNTU_VERSIONS=""
# Optional explicit glob override. With XRT_DEB_GLOBS_MODE=auto (default), these
# globs are used only after version preference finds no packages.
# Set XRT_DEB_GLOBS_MODE=override to skip version fallback and require this list.
XRT_DEB_GLOBS=""
XRT_DEB_GLOBS_MODE="auto"
RYZEN_AI_INSTALL_ROOT=".ai370-ai/ryzen-ai"

# ComfyUI launcher behavior after acceleration installation/validation.
COMFYUI_ACCELERATION_MODE="auto"
