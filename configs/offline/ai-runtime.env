# SPDX-License-Identifier: GPL-3.0-only
# Offline local-AI artifact locations. Paths are relative to the repository root
# unless written as absolute paths.
#
# Consumed by scripts/lib/offline-paths.sh (sourced by S2-M3 installers):
#   scripts/300-install-anythingllm.sh
#   scripts/310-install-embedding-models.sh
#   scripts/320-validate-rag.sh
#
# Explicit env overrides (highest priority when set):
#   ANYTHINGLLM_STAGED_DIR, ANYTHINGLLM_APPIMAGE_DIR, ANYTHINGLLM_DOC_DIR,
#   ANYTHINGLLM_STORAGE_DIR, EMBEDDING_STAGED_DIR, EMBEDDING_MODEL_DIR,
#   EMBEDDING_VENV_DIR

OFFLINE_WHEELHOUSE=".ai370-ai/wheelhouse"
OFFLINE_MODEL_ROOT=".ai370-ai/models"
OFFLINE_TOOL_ROOT=".ai370-ai/tools"
OFFLINE_REQUIREMENTS="configs/ai-runtime/requirements-offline.txt"

# S2-M3 Offline RAG staging (AnythingLLM + embeddings)
OFFLINE_ANYTHINGLLM_DIR=".ai370-ai/offline-artifacts/anythingllm"
OFFLINE_EMBEDDING_DIR=".ai370-ai/offline-artifacts/embedding"
OFFLINE_RAG_DOC_DIR=".ai370-ai/rag/documents"
OFFLINE_RAG_STORAGE_DIR=".ai370-ai/rag/anythingllm-storage"

# S2-M6 TurnkeyML + Lemonade (OpenAI-compatible LLM serving)
OFFLINE_LEMONADE_VENV=".ai370-ai/lemonade/venv"
OFFLINE_LEMONADE_DIR=".ai370-ai/offline-artifacts/lemonade"
OFFLINE_TURNKEYML_DIR=".ai370-ai/offline-artifacts/turnkeyml"
OFFLINE_LEMONADE_MODEL_DIR=".ai370-ai/models/lemonade"

# S2-M7 Digest AI (model analysis diagnostics only — not NPU proof)
OFFLINE_DIGEST_VENV=".ai370-ai/digest/venv"
OFFLINE_DIGEST_DIR=".ai370-ai/offline-artifacts/digestai"
OFFLINE_DIGEST_SRC=".ai370-ai/tools/digestai"
OFFLINE_DIGEST_MODEL_DIR=".ai370-ai/models"
