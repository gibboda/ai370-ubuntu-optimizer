{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai370.local/schemas/s2-m7-platform-validation-v1.json",
  "title": "S2-M7 Platform Validation v1",
  "description": "Stage 2 platform validation aggregate. Consumes Stage 1 profile facts and Stage 2 milestone reports; records reference-platform acceptance policy. Does not prove runtime execution.",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "milestone",
    "artifact",
    "consumed_profile",
    "status",
    "scope",
    "strict",
    "cli_profile",
    "classified_platform_id",
    "acceptance",
    "checks",
    "milestones",
    "artifacts",
    "failures",
    "warnings",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "stage": {"const": 2},
    "milestone": {"const": "S2-M7"},
    "artifact": {"const": "s2-m7-platform-validation"},
    "consumed_profile": {"$ref": "#/$defs/consumedProfile"},
    "status": {"$ref": "#/$defs/gateStatus"},
    "scope": {"enum": ["inventory", "full", "smoke"]},
    "strict": {"type": "boolean"},
    "cli_profile": {"type": "string", "minLength": 1},
    "classified_platform_id": {"type": ["string", "null"]},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "checks": {"$ref": "#/$defs/checks"},
    "milestones": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/milestoneEntry"}
    },
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "schemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "s2-m7-platform-validation"},
        "version": {"const": 1},
        "uri": {"const": "https://ai370.local/schemas/s2-m7-platform-validation-v1.json"}
      }
    },
    "profileSchemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "ai370-system-profile"},
        "version": {"const": 3},
        "uri": {"const": "https://ai370.local/schemas/system-profile-v3.json"}
      }
    },
    "fingerprintRef": {
      "type": "object",
      "required": ["algorithm", "algorithm_version", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "algorithm_version": {"const": 1},
        "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumedProfile": {
      "type": "object",
      "required": ["artifact", "schema", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "artifact": {"type": ["string", "null"]},
        "schema": {"$ref": "#/$defs/profileSchemaIdentity"},
        "fingerprint": {"$ref": "#/$defs/fingerprintRef"}
      }
    },
    "gateStatus": {
      "enum": ["PASS", "WARN", "FAIL", "UNSUPPORTED", "SKIPPED"]
    },
    "visibilityState": {
      "enum": ["visible", "not-visible", "unknown", "not-applicable"]
    },
    "acceptance": {
      "type": "object",
      "required": [
        "radeon_890m_gfx1150",
        "amdxdna_npu",
        "vulkan_validated",
        "bios_version_acceptable",
        "inventory_only",
        "ai_smoke_required"
      ],
      "additionalProperties": false,
      "properties": {
        "radeon_890m_gfx1150": {"type": "boolean"},
        "amdxdna_npu": {"type": "boolean"},
        "vulkan_validated": {"type": "boolean"},
        "bios_version_acceptable": {"enum": ["true", "false", "unknown"]},
        "inventory_only": {"type": "boolean"},
        "ai_smoke_required": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object",
      "required": ["gpu_arch", "npu_present", "vulkan", "amdgpu", "bios_acceptable"],
      "additionalProperties": false,
      "properties": {
        "gpu_arch": {"type": ["string", "null"]},
        "npu_present": {"type": ["boolean", "null"]},
        "vulkan": {"$ref": "#/$defs/visibilityState"},
        "amdgpu": {"enum": ["loaded", "missing", "unknown"]},
        "bios_acceptable": {"enum": ["true", "false", "unknown"]}
      }
    },
    "milestoneEntry": {
      "type": "object",
      "required": ["id", "artifact", "status", "canonical"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["S2-M1", "S2-M2", "S2-M3", "S2-M4", "S2-M5"]},
        "artifact": {"type": ["string", "null"]},
        "status": {
          "enum": ["PASS", "WARN", "FAIL", "UNSUPPORTED", "SKIPPED", "MISSING"]
        },
        "canonical": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "hardware",
        "kernel",
        "gpu_stack",
        "npu",
        "firmware",
        "firmware_validation",
        "platform_tuning",
        "local_ai"
      ],
      "additionalProperties": false,
      "properties": {
        "hardware": {"type": ["string", "null"]},
        "kernel": {"type": ["string", "null"]},
        "gpu_stack": {"type": ["string", "null"]},
        "npu": {"type": ["string", "null"]},
        "firmware": {"type": ["string", "null"]},
        "firmware_validation": {"type": ["string", "null"]},
        "platform_tuning": {"type": ["string", "null"]},
        "local_ai": {"type": ["string", "null"]}
      }
    }
  }
}
