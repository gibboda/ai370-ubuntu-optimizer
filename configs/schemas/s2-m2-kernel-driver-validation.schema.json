{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai370.local/schemas/s2-m2-kernel-driver-validation-v1.json",
  "title": "S2-M2 Kernel Driver Validation v1",
  "description": "Stage 2 kernel and driver validation. Records kernel/OS/module/firmware observations against a minimum kernel target. Does not change kernel parameters, packages, or firmware files.",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "milestone",
    "artifact",
    "consumed_profile",
    "status",
    "cli_profile",
    "classified_platform_id",
    "mode",
    "persistence",
    "dry_run",
    "kernel",
    "os",
    "modules",
    "firmware",
    "recommendations",
    "warnings",
    "notes",
    "compatibility_reports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "stage": {"const": 2},
    "milestone": {"const": "S2-M2"},
    "artifact": {"const": "s2-m2-kernel-driver-validation"},
    "consumed_profile": {"$ref": "#/$defs/consumedProfile"},
    "status": {"$ref": "#/$defs/gateStatus"},
    "cli_profile": {"type": "string", "minLength": 1},
    "classified_platform_id": {"type": ["string", "null"]},
    "mode": {"type": "string", "minLength": 1},
    "persistence": {"type": "string", "minLength": 1},
    "dry_run": {"type": "boolean"},
    "kernel": {"$ref": "#/$defs/kernelFacts"},
    "os": {"$ref": "#/$defs/osFacts"},
    "modules": {"$ref": "#/$defs/moduleFacts"},
    "firmware": {"$ref": "#/$defs/kernelFirmwareFacts"},
    "recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compatibility_reports": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "schemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "s2-m2-kernel-driver-validation"},
        "version": {"const": 1},
        "uri": {"const": "https://ai370.local/schemas/s2-m2-kernel-driver-validation-v1.json"}
      }
    },
    "profileSchemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "ai370-system-profile"},
        "version": {"const": 3},
        "uri": {"const": "https://ai370.local/schemas/system-profile-v3.json"}
      }
    },
    "fingerprintRef": {
      "type": "object",
      "required": ["algorithm", "algorithm_version", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "algorithm_version": {"const": 1},
        "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumedProfile": {
      "type": "object",
      "required": ["artifact", "schema", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "artifact": {"type": ["string", "null"]},
        "schema": {"$ref": "#/$defs/profileSchemaIdentity"},
        "fingerprint": {"$ref": "#/$defs/fingerprintRef"}
      }
    },
    "gateStatus": {
      "enum": ["PASS", "WARN", "FAIL", "UNSUPPORTED", "SKIPPED"]
    },
    "kernelFacts": {
      "type": "object",
      "required": ["version", "target_minimum", "acceptable"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string"},
        "target_minimum": {"type": "string"},
        "acceptable": {"type": ["boolean", "null"]}
      }
    },
    "osFacts": {
      "type": "object",
      "required": ["description", "version_id", "codename"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "version_id": {"type": "string"},
        "codename": {"type": "string"}
      }
    },
    "moduleFacts": {
      "type": "object",
      "required": ["amdgpu_loaded", "amdxdna_seen"],
      "additionalProperties": false,
      "properties": {
        "amdgpu_loaded": {"type": "boolean"},
        "amdxdna_seen": {"type": "boolean"}
      }
    },
    "kernelFirmwareFacts": {
      "type": "object",
      "required": ["amdgpu_directory"],
      "additionalProperties": false,
      "properties": {
        "amdgpu_directory": {"enum": ["present", "missing", "unknown"]}
      }
    }
  }
}
