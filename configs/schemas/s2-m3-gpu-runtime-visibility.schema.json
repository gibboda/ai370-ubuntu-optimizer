{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai370.local/schemas/s2-m3-gpu-runtime-visibility-v1.json",
  "title": "S2-M3 GPU Runtime Visibility v1",
  "description": "Stage 2 GPU, Vulkan, and ROCm visibility assessment. Records ladder progression and visibility checks; does not prove workload execution.",
  "type": "object",
  "required": ["schema", "stage", "milestone", "artifact", "consumed_profile", "status", "checks", "ladder", "notes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "stage": {"const": 2},
    "milestone": {"const": "S2-M3"},
    "artifact": {"const": "s2-m3-gpu-runtime-visibility"},
    "consumed_profile": {"$ref": "#/$defs/consumedProfile"},
    "status": {"$ref": "#/$defs/gateStatus"},
    "checks": {"$ref": "#/$defs/gpuChecks"},
    "ladder": {"$ref": "#/$defs/gpuLadder"},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "schemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "s2-m3-gpu-runtime-visibility"},
        "version": {"const": 1},
        "uri": {"const": "https://ai370.local/schemas/s2-m3-gpu-runtime-visibility-v1.json"}
      }
    },
    "profileSchemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "ai370-system-profile"},
        "version": {"const": 3},
        "uri": {"const": "https://ai370.local/schemas/system-profile-v3.json"}
      }
    },
    "fingerprintRef": {
      "type": "object",
      "required": ["algorithm", "algorithm_version", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "algorithm_version": {"const": 1},
        "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumedProfile": {
      "type": "object",
      "required": ["artifact", "schema", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "artifact": {"type": ["string", "null"]},
        "schema": {"$ref": "#/$defs/profileSchemaIdentity"},
        "fingerprint": {"$ref": "#/$defs/fingerprintRef"}
      }
    },
    "gateStatus": {
      "enum": ["PASS", "WARN", "FAIL", "UNSUPPORTED", "SKIPPED"]
    },
    "visibilityState": {
      "enum": ["visible", "not-visible", "unknown", "not-applicable"]
    },
    "gpuChecks": {
      "type": "object",
      "required": ["amdgpu", "gpu_arch", "vulkan", "opencl", "rocm"],
      "additionalProperties": false,
      "properties": {
        "amdgpu": {"enum": ["loaded", "missing", "unknown"]},
        "gpu_arch": {"type": ["string", "null"]},
        "vulkan": {"$ref": "#/$defs/visibilityState"},
        "opencl": {"$ref": "#/$defs/visibilityState"},
        "rocm": {"$ref": "#/$defs/visibilityState"}
      }
    },
    "stepStatus": {
      "enum": ["satisfied", "not_satisfied", "unknown", "skipped", "unsupported"]
    },
    "assessmentState": {
      "enum": ["AVAILABLE", "READY", "DEGRADED", "UNSUPPORTED", "UNKNOWN"]
    },
    "gpuLadderStepId": {
      "enum": [
        "DETECTED",
        "DRIVER_READY",
        "VULKAN_READY",
        "ROCM_READY",
        "HIP_READY",
        "FRAMEWORK_READY",
        "APPLICATION_READY"
      ]
    },
    "ladderStep": {
      "type": "object",
      "required": ["id", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/gpuLadderStepId"},
        "status": {"$ref": "#/$defs/stepStatus"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gpuLadder": {
      "type": "object",
      "required": ["domain", "current", "assessment", "steps", "validation_claim"],
      "additionalProperties": false,
      "properties": {
        "domain": {"const": "gpu"},
        "current": {"type": ["string", "null"]},
        "assessment": {"$ref": "#/$defs/assessmentState"},
        "steps": {
          "type": "array",
          "minItems": 7,
          "items": {"$ref": "#/$defs/ladderStep"}
        },
        "validation_claim": {"const": false}
      }
    }
  }
}
