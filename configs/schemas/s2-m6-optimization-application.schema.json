{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai370.local/schemas/s2-m6-optimization-application-v1.json",
  "title": "S2-M6 Optimization Application v1",
  "description": "Stage 2 approved optimization application. Records whether --approve was given and whether runtime commands ran. Backup and rollback remain Planned.",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "milestone",
    "artifact",
    "consumed_profile",
    "status",
    "cli_profile",
    "classified_platform_id",
    "approved",
    "dry_run",
    "applied",
    "plan_artifact",
    "runtime_apply",
    "backup",
    "warnings",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "stage": {"const": 2},
    "milestone": {"const": "S2-M6"},
    "artifact": {"const": "s2-m6-optimization-application"},
    "consumed_profile": {"$ref": "#/$defs/consumedProfile"},
    "status": {"$ref": "#/$defs/gateStatus"},
    "cli_profile": {"type": "string", "minLength": 1},
    "classified_platform_id": {"type": ["string", "null"]},
    "approved": {"const": true},
    "dry_run": {"type": "boolean"},
    "applied": {"type": "boolean"},
    "plan_artifact": {"type": "string", "minLength": 1},
    "runtime_apply": {"$ref": "#/$defs/runtimeApply"},
    "backup": {"$ref": "#/$defs/backup"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "schemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "s2-m6-optimization-application"},
        "version": {"const": 1},
        "uri": {"const": "https://ai370.local/schemas/s2-m6-optimization-application-v1.json"}
      }
    },
    "profileSchemaIdentity": {
      "type": "object",
      "required": ["name", "version", "uri"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "ai370-system-profile"},
        "version": {"const": 3},
        "uri": {"const": "https://ai370.local/schemas/system-profile-v3.json"}
      }
    },
    "fingerprintRef": {
      "type": "object",
      "required": ["algorithm", "algorithm_version", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "algorithm_version": {"const": 1},
        "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumedProfile": {
      "type": "object",
      "required": ["artifact", "schema", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "artifact": {"type": ["string", "null"]},
        "schema": {"$ref": "#/$defs/profileSchemaIdentity"},
        "fingerprint": {"$ref": "#/$defs/fingerprintRef"}
      }
    },
    "gateStatus": {
      "enum": ["PASS", "WARN", "FAIL", "UNSUPPORTED", "SKIPPED"]
    },
    "runtimeApply": {
      "type": "object",
      "required": ["requested", "applied", "dry_run", "commands"],
      "additionalProperties": false,
      "properties": {
        "requested": {"type": "boolean"},
        "applied": {"type": "boolean"},
        "dry_run": {"type": "boolean"},
        "commands": {"type": "string", "minLength": 1}
      }
    },
    "backup": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["not-implemented"]},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
