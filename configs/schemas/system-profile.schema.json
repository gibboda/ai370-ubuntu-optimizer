{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai370.local/schemas/system-profile-v2.json",
  "title": "AI370 Stage 1 System Profile v2",
  "description": "Authoritative, read-only machine facts consumed by Stage 2 and later.",
  "type": "object",
  "required": ["schema", "generation", "fingerprint", "system", "operating_system", "kernel", "cpu", "memory", "storage", "gpus", "accelerators", "firmware", "collection", "classification", "capability_candidates", "unknown_facts"],
  "properties": {
    "schema": {"$ref": "#/$defs/schemaIdentity"},
    "generation": {"$ref": "#/$defs/generation"},
    "fingerprint": {"$ref": "#/$defs/fingerprint"},
    "system": {"$ref": "#/$defs/system"},
    "operating_system": {"$ref": "#/$defs/operatingSystem"},
    "kernel": {"$ref": "#/$defs/kernel"},
    "cpu": {"$ref": "#/$defs/cpu"},
    "memory": {"$ref": "#/$defs/memory"},
    "storage": {"type": "array", "items": {"$ref": "#/$defs/storageDevice"}},
    "gpus": {"type": "array", "items": {"$ref": "#/$defs/gpuDevice"}},
    "accelerators": {"type": "array", "items": {"$ref": "#/$defs/acceleratorDevice"}},
    "firmware": {"$ref": "#/$defs/firmware"},
    "collection": {"$ref": "#/$defs/collection"},
    "classification": {"$ref": "#/$defs/classification"},
    "capability_candidates": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "unknown_facts": {"type": "array", "items": {"$ref": "#/$defs/unknownFact"}}
  },
  "additionalProperties": false,
  "$defs": {
    "state": {"enum": ["observed", "not_present", "unsupported", "unknown", "tool_missing", "permission_denied", "probe_failed", "unrecognized"]},
    "nullableString": {"type": ["string", "null"]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "schemaIdentity": {
      "type": "object", "required": ["name", "version", "uri"],
      "properties": {"name": {"const": "ai370-system-profile"}, "version": {"const": 2}, "uri": {"const": "https://ai370.local/schemas/system-profile-v2.json"}},
      "additionalProperties": false
    },
    "generation": {
      "type": "object", "required": ["timestamp", "generator", "complete"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "generator": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "system_profile.py"}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "complete": {"type": "boolean"}
      }, "additionalProperties": false
    },
    "fingerprint": {
      "type": "object", "required": ["algorithm", "value", "inputs"],
      "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
      "additionalProperties": false
    },
    "motherboard": {
      "type": "object", "required": ["state", "manufacturer", "product", "version", "serial"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "manufacturer": {"$ref": "#/$defs/nullableString"}, "product": {"$ref": "#/$defs/nullableString"}, "version": {"$ref": "#/$defs/nullableString"}, "serial": {"$ref": "#/$defs/nullableString"}},
      "additionalProperties": false
    },
    "system": {
      "type": "object", "required": ["state", "manufacturer", "product", "version", "serial", "uuid", "motherboard"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "manufacturer": {"$ref": "#/$defs/nullableString"}, "product": {"$ref": "#/$defs/nullableString"}, "version": {"$ref": "#/$defs/nullableString"}, "serial": {"$ref": "#/$defs/nullableString"}, "uuid": {"$ref": "#/$defs/nullableString"}, "motherboard": {"$ref": "#/$defs/motherboard"}},
      "additionalProperties": false
    },
    "operatingSystem": {
      "type": "object", "required": ["state", "id", "name", "pretty_name", "version_id", "version_codename"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "id": {"$ref": "#/$defs/nullableString"}, "name": {"$ref": "#/$defs/nullableString"}, "pretty_name": {"$ref": "#/$defs/nullableString"}, "version_id": {"$ref": "#/$defs/nullableString"}, "version_codename": {"$ref": "#/$defs/nullableString"}},
      "additionalProperties": false
    },
    "kernel": {
      "type": "object", "required": ["state", "release", "architecture", "command_line"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "release": {"$ref": "#/$defs/nullableString"}, "architecture": {"$ref": "#/$defs/nullableString"}, "command_line": {"$ref": "#/$defs/nullableString"}},
      "additionalProperties": false
    },
    "cpu": {
      "type": "object", "required": ["state", "vendor_id", "model_name", "architecture", "family", "model", "stepping", "topology"],
      "properties": {
        "state": {"$ref": "#/$defs/state"}, "vendor_id": {"$ref": "#/$defs/nullableString"}, "model_name": {"$ref": "#/$defs/nullableString"}, "architecture": {"$ref": "#/$defs/nullableString"}, "family": {"$ref": "#/$defs/nullableInteger"}, "model": {"$ref": "#/$defs/nullableInteger"}, "stepping": {"$ref": "#/$defs/nullableInteger"},
        "topology": {"type": "object", "required": ["sockets", "physical_cores", "logical_processors", "cores_per_socket", "threads_per_core"], "properties": {"sockets": {"$ref": "#/$defs/nullableInteger"}, "physical_cores": {"$ref": "#/$defs/nullableInteger"}, "logical_processors": {"$ref": "#/$defs/nullableInteger"}, "cores_per_socket": {"$ref": "#/$defs/nullableInteger"}, "threads_per_core": {"$ref": "#/$defs/nullableInteger"}}, "additionalProperties": false}
      }, "additionalProperties": false
    },
    "memory": {
      "type": "object", "required": ["state", "total_bytes", "available_bytes"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "total_bytes": {"$ref": "#/$defs/nullableInteger"}, "available_bytes": {"$ref": "#/$defs/nullableInteger"}}, "additionalProperties": false
    },
    "pciIdentity": {
      "type": "object", "required": ["address", "vendor_id", "device_id", "subsystem_vendor_id", "subsystem_device_id"],
      "properties": {"address": {"$ref": "#/$defs/nullableString"}, "vendor_id": {"$ref": "#/$defs/nullableString"}, "device_id": {"$ref": "#/$defs/nullableString"}, "subsystem_vendor_id": {"$ref": "#/$defs/nullableString"}, "subsystem_device_id": {"$ref": "#/$defs/nullableString"}}, "additionalProperties": false
    },
    "storageDevice": {
      "type": "object", "required": ["state", "name", "device_path", "kind", "transport", "size_bytes", "removable", "model", "serial", "firmware_version"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "name": {"type": "string", "minLength": 1}, "device_path": {"$ref": "#/$defs/nullableString"}, "kind": {"enum": ["disk", "partition", "rom", "loop", "unknown"]}, "transport": {"enum": ["nvme", "sata", "usb", "virtio", "mmc", "unknown", null]}, "size_bytes": {"$ref": "#/$defs/nullableInteger"}, "removable": {"type": ["boolean", "null"]}, "model": {"$ref": "#/$defs/nullableString"}, "serial": {"$ref": "#/$defs/nullableString"}, "firmware_version": {"$ref": "#/$defs/nullableString"}}, "additionalProperties": false
    },
    "driverBinding": {
      "type": "object", "required": ["state", "name"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "name": {"$ref": "#/$defs/nullableString"}},
      "additionalProperties": false
    },
    "gpuDevice": {
      "type": "object", "required": ["state", "id", "name", "pci", "driver", "architecture", "vram_bytes", "runtime"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "id": {"type": "string", "minLength": 1}, "name": {"$ref": "#/$defs/nullableString"}, "pci": {"$ref": "#/$defs/pciIdentity"}, "driver": {"$ref": "#/$defs/driverBinding"}, "architecture": {"$ref": "#/$defs/nullableString"}, "vram_bytes": {"$ref": "#/$defs/nullableInteger"}, "runtime": {"enum": ["observed", "not_present", "unsupported", "unknown", "tool_missing", "permission_denied", "probe_failed", "unrecognized"]}}, "additionalProperties": false
    },
    "acceleratorDevice": {
      "type": "object", "required": ["state", "id", "kind", "name", "pci", "device_nodes", "driver", "runtime"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["npu", "fpga", "dsp", "other", "unknown"]}, "name": {"$ref": "#/$defs/nullableString"}, "pci": {"$ref": "#/$defs/pciIdentity"}, "device_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "driver": {"$ref": "#/$defs/driverBinding"}, "runtime": {"$ref": "#/$defs/state"}}, "additionalProperties": false
    },
    "firmware": {
      "type": "object", "required": ["state", "bios_vendor", "bios_version", "bios_date", "uefi", "secure_boot"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "bios_vendor": {"$ref": "#/$defs/nullableString"}, "bios_version": {"$ref": "#/$defs/nullableString"}, "bios_date": {"$ref": "#/$defs/nullableString"}, "uefi": {"$ref": "#/$defs/state"}, "secure_boot": {"type": "object", "required": ["state", "enabled"], "properties": {"state": {"$ref": "#/$defs/state"}, "enabled": {"type": ["boolean", "null"]}}, "additionalProperties": false}}, "additionalProperties": false
    },
    "tool": {
      "type": "object", "required": ["name", "state", "path", "version", "error"],
      "properties": {"name": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/state"}, "path": {"$ref": "#/$defs/nullableString"}, "version": {"$ref": "#/$defs/nullableString"}, "error": {"$ref": "#/$defs/error"}}, "additionalProperties": false
    },
    "probe": {
      "type": "object", "required": ["id", "state", "source", "error"],
      "properties": {"id": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/state"}, "source": {"type": "string", "minLength": 1}, "error": {"$ref": "#/$defs/error"}}, "additionalProperties": false
    },
    "collection": {
      "type": "object", "required": ["tools", "probes"],
      "properties": {"tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}}, "probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}}}, "additionalProperties": false
    },
    "classification": {
      "type": "object", "required": ["state", "platform_id", "confidence", "evidence", "mismatches"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "platform_id": {"$ref": "#/$defs/nullableString"}, "confidence": {"enum": ["exact", "family", "none"]}, "evidence": {"type": "array", "items": {"type": "string"}}, "mismatches": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false
    },
    "capability": {
      "type": "object", "required": ["id", "state", "candidate", "evidence"],
      "properties": {"id": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/state"}, "candidate": {"type": ["boolean", "null"]}, "evidence": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false
    },
    "unknownFact": {
      "type": "object", "required": ["path", "state", "reason"],
      "properties": {"path": {"type": "string", "pattern": "^[a-z][a-z0-9_.\\[\\]-]*$"}, "state": {"enum": ["unknown", "unsupported", "unrecognized"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false
    }
  }
}
