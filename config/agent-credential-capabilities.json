{
  "schema_version": 1,
  "authority": "AGENTS.md",
  "purpose": "Machine-readable credential capability contract derived from AGENTS.md and .github/github-mcp.md. This file contains no secret values and does not grant permissions.",
  "clients": {
    "cursor": {
      "role": "primary_orchestrator",
      "runtime": "local_or_hosted",
      "github_auth": {
        "mode": "pat_or_hosted_integration",
        "credential_variable": "CURSOR_GH_PAT",
        "credential_domain": "github",
        "shared_credential_allowed": false
      },
      "capabilities": {
        "repositories": "read_write",
        "issues": "read_write",
        "pull_requests": "read_write",
        "projects": "read_write_when_authorized"
      },
      "default_posture": "read_write_within_granted_scope",
      "mutation_condition": "Allowed only within granted GitHub authorization and repository governance; Project writes require project permission."
    },
    "grok_build": {
      "role": "independent_reviewer",
      "runtime": "local",
      "github_auth": {
        "mode": "pat",
        "credential_variable": "GROK_GH_PAT",
        "credential_domain": "github",
        "shared_credential_allowed": false
      },
      "capabilities": {
        "repositories": "read_only",
        "issues": "read_only",
        "pull_requests": "read_only",
        "projects": "read_only"
      },
      "default_posture": "read_only",
      "mutation_condition": "No GitHub mutation by default; independent review is advisory."
    },
    "antigravity": {
      "role": "secondary_specialist",
      "runtime": "local",
      "github_auth": {
        "mode": "pat",
        "credential_variable": "ANTIGRAVITY_GH_PAT",
        "credential_domain": "github",
        "shared_credential_allowed": false
      },
      "capabilities": {
        "repositories": "read_write_when_authorized",
        "issues": "read_write_when_authorized",
        "pull_requests": "read_write_when_authorized",
        "projects": "read_only_by_default"
      },
      "default_posture": "read_by_default",
      "mutation_condition": "Repository mutation requires explicit task need and granted token permission; Project mutation additionally requires explicit project permission."
    },
    "github_copilot": {
      "role": "github_native_fallback",
      "runtime": "github_native_or_vscode",
      "github_auth": {
        "mode": "oauth_or_session",
        "credential_variable": null,
        "credential_domain": "github",
        "shared_credential_allowed": false
      },
      "capabilities": {
        "repositories": "authorization_dependent",
        "issues": "authorization_dependent",
        "pull_requests": "authorization_dependent",
        "projects": "authorization_dependent"
      },
      "default_posture": "github_authorization_dependent",
      "mutation_condition": "Use only capabilities granted by GitHub OAuth/session authorization; do not replace working OAuth with a repository PAT."
    }
  },
  "credential_domains": {
    "github": {
      "purpose": "GitHub repository, Issues, pull requests, Projects, and MCP authorization.",
      "reserved_prefixes": ["GITHUB_"],
      "forbidden_suffixes": ["_API_KEY"]
    },
    "vendor": {
      "purpose": "Vendor model or CLI authentication where separately required.",
      "must_not_be_used_for_github_authorization": true,
      "preferred_naming": "Use client- or vendor-specific token/credential names that do not start with GITHUB_ and do not end in _API_KEY."
    }
  },
  "invariants": {
    "no_secret_values": true,
    "least_privilege": true,
    "separate_client_credentials": true,
    "no_shared_unrestricted_pat": true,
    "github_governance_not_bypassable": true,
    "portable_secret_names": true
  }
}
