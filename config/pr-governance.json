{
  "schema_version": 1,
  "authority": "AGENTS.md",
  "target_branch": "main",
  "ruleset": {
    "name": "Protect main",
    "enforcement": "active",
    "require_pull_request": true,
    "minimum_approving_reviews": 1,
    "require_code_owner_reviews": true,
    "require_review_thread_resolution": true,
    "required_status_checks": ["ShellCheck"]
  },
  "advisory_ai_review": {
    "merge_gate": false,
    "required_status_check": false,
    "providers": ["grok_build", "antigravity", "antigravity_cli", "github_copilot", "codex", "maintainer_approved"],
    "forbidden_required_check_terms": ["bugbot", "grok", "antigravity", "gemini", "copilot", "codex", "ai review", "llm"]
  },
  "review_pipeline": {
    "required_github_reviewer": "gibboda",
    "required_github_reviewer_is_codeowner": true,
    "cursor_bugbot": {
      "role": "cursor_native_pr_review",
      "advisory": true,
      "merge_gate": false,
      "required_status_check": false,
      "default_effort_preferred": true,
      "autofix": {
        "preferred_first_remediation_for_bugbot_findings": true,
        "preferred_target": "new_branch",
        "automatic_downstream_vendor_escalation": false,
        "deterministic_revalidation_required": true
      }
    },
    "second_look": {
      "assignable_by": "codeowner",
      "providers": ["grok_build", "antigravity"],
      "cli_advisory_reviewers": ["grok_build", "antigravity_cli"],
      "allowed_roles": ["independent_reviewer", "secondary_specialist"],
      "selection": "any_or_both",
      "advice_record": {
        "required_when_assigned": true,
        "forms": ["pull_request_comment", "comment_review"],
        "form_constraints": {"comment_review": {"github_review_state": "comment_only"}, "pull_request_comment": {"github_review_state": null}},
        "attribution_required": true,
        "forbidden_states": ["approve", "request_changes"],
        "satisfies_branch_protection": false,
        "mcp_write": false,
        "proxy_posters": ["cursor", "codeowner"]
      },
      "independent_reviewer_fallback": {
        "provider": "antigravity_cli",
        "when": "grok_build_unavailable",
        "replaces": "grok_build",
        "does_not_replace": "antigravity",
        "peer_of_grok_build": false,
        "may_be_assigned_when_grok_available": true
      },
      "github_codeowners_identity": false,
      "merge_gate": false,
      "required_status_check": false
    },
    "final_advisory_specialist_pass": {
      "process_required": true,
      "providers": ["github_copilot", "codex"],
      "selection": "any_or_both",
      "github_review_state": "comment_only",
      "satisfies_branch_protection": false,
      "merge_gate": false,
      "required_status_check": false
    },
    "final_advisory_specialist_pass": {
      "process_required": false,
      "providers": ["github_copilot", "codex"],
      "selection": "human_controlled_one_at_a_time",
      "when": "prior_capable_agents_unable_to_safely_resolve_gap",
      "github_copilot_precedes_codex": true,
      "automatic": false,
      "satisfies_branch_protection": false,
      "merge_gate": false,
      "required_status_check": false
    }
  },
  "invariants": {
    "human_final_authority": true,
    "deterministic_checks_authoritative_for_machine_verifiable_facts": true,
    "optional_ai_unavailability_must_not_block_merge": true,
    "mcp_access_does_not_bypass_governance": true,
    "no_automatic_vendor_chaining": true
  }
}
