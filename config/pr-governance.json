{
  "schema_version": 2,
  "authority": "AGENTS.md",
  "target_branch": "main",
  "ruleset": {"name": "Protect main", "enforcement": "active", "require_pull_request": true, "minimum_approving_reviews": 1, "require_code_owner_reviews": true, "require_review_thread_resolution": true, "required_status_checks": ["ShellCheck"]},
  "advisory_ai_review": {"merge_gate": false, "required_status_check": false, "providers": ["cursor_bugbot", "grok_build", "antigravity", "antigravity_cli", "github_copilot", "codex", "maintainer_approved"], "forbidden_required_check_terms": ["bugbot", "grok", "antigravity", "gemini", "copilot", "codex", "ai review", "llm"]},
  "review_pipeline": {
    "required_github_reviewer": "gibboda", "required_github_reviewer_is_codeowner": true,
    "logical_order": ["cursor_implementation", "cursor_bugbot", "second_look", "final_advisory_specialist_pass", "final_required_checks", "codeowner_merge"],
    "logical_order_semantics": "Readiness ordering only. Checks may execute earlier or continuously; final merge eligibility uses check results after all accepted AI-generated modifications.",
    "cursor_bugbot": {"role": "cursor_native_pr_review", "role_identity": "cursor_native_autofixer", "role_label": "Cursor-Native Autofixer", "advisory": true, "merge_gate": false, "required_status_check": false, "default_effort_preferred": true, "autofix": {"preferred_first_remediation_for_bugbot_findings": true, "preferred_target": "new_branch", "automatic_downstream_vendor_escalation": false, "deterministic_revalidation_required": true}},
    "second_look": {"assignable_by": "codeowner", "providers": ["grok_build", "antigravity"], "cli_advisory_reviewers": ["grok_build", "antigravity_cli"], "allowed_roles": ["independent_reviewer", "secondary_specialist"], "selection": "any_or_both", "precedes_final_advisory_specialist_pass": true, "advice_record": {"required_when_assigned": true, "forms": ["pull_request_comment", "comment_review"], "form_constraints": {"comment_review": {"github_review_state": "comment_only"}, "pull_request_comment": {"github_review_state": null}}, "attribution_required": true, "forbidden_states": ["approve", "request_changes"], "satisfies_branch_protection": false, "mcp_write": false, "proxy_posters": ["cursor", "codeowner"]}, "independent_reviewer_fallback": {"enabled": false, "provider": null, "when": "never", "replaces": null, "does_not_replace": "antigravity", "peer_of_grok_build": false, "may_be_assigned_when_grok_available": false, "transfers_independent_review_role": false}, "github_codeowners_identity": false, "merge_gate": false, "required_status_check": false},
    "final_advisory_specialist_pass": {"role_labels": {"github_copilot": "GitHub-Native Coding Agent", "codex": "Codex Coding Agent", "antigravity": "Secondary / Specialist Agent"}, "process_required": false, "process_required_for": ["high"], "process_required_semantics": "required_only_when_recorded_risk_tier_is_in_process_required_for", "risk_tiered": true, "required_risk_tiers": ["high"], "optional_risk_tiers": ["standard", "low"], "default_risk_tier": "standard", "risk_tier_precedence": "highest_matching_wins", "risk_tier_rank": ["high", "standard", "low"], "risk_tier_criteria": {"high": ["security", "credentials_or_secrets", "agent_hierarchy_or_merge_authority", "branch_protection_or_required_checks", "schema_or_contract", "stage_boundary_or_profile_contract", "apply_path_or_system_mutation"], "standard": ["runtime_behavior", "ci_workflows_without_required_check_change", "non_security_feature_work"], "low": ["docs_only", "changelog_only", "test_only_without_weakening", "chore_or_dependency_bump"]}, "providers": ["github_copilot", "codex"], "selection": "any_or_both", "after_second_look": true, "before_final_required_checks": true, "github_review_state": "comment_only", "satisfies_branch_protection": false, "merge_gate": false, "required_status_check": false, "skip_record_required_when_not_run": true, "template_risk_tier_field": "Risk tier:", "template_specialist_pass_field": "Specialist pass:", "specialist_pass_record_values": ["completed", "skipped", "unavailable", "requested"], "codeowner_may_request_on_optional_tiers": true, "bounded_capacity_failover": {"enabled": true, "providers": ["github_copilot", "codex", "antigravity"], "selection": "first_available", "trigger_reasons": ["quota_exhausted", "service_unavailable", "provider_error"], "non_trigger_reasons": ["authentication_failure", "configuration_failure", "task_completed", "review_completed", "not_required"], "stop_after_first_success": true, "max_attempts": 3, "sequential_only": true, "preserve_role_boundaries": true, "grok_independent_review_excluded": true, "record_failure_reason": true}},
    "final_required_checks": {"provider": "github_actions_and_repository_checks", "after_accepted_ai_modifications": true, "authoritative_for_machine_verifiable_facts": true},
    "codeowner_merge": {"provider": "gibboda", "human_final": true, "after_final_required_checks": true}
  },
  "invariants": {"human_final_authority": true, "deterministic_checks_authoritative_for_machine_verifiable_facts": true, "optional_ai_unavailability_must_not_block_merge": true, "mcp_access_does_not_bypass_governance": true, "no_automatic_vendor_chaining": true, "bounded_role_failover": true, "provider_quota_exhaustion_is_not_workflow_completion": true, "required_work_continues_on_provider_capacity_failure": true, "native_specialist_pass_precedes_final_required_checks": true}
}
